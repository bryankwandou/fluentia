# Groq powers both the tutor conversation and the speech grader.
GROQ_API_KEY=

# Registrar wallet that countersigns credentials. Accepts a 32-byte hex seed,
# a base58 secret key, or a JSON byte array. Needs devnet SOL for fees.
SOLANA_REGISTRAR_KEY=

# Any devnet RPC endpoint. Defaults to the public one when unset.
SOLANA_RPC_URL=https://api.devnet.solana.com
